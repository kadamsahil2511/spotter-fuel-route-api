# Debug is off unless you export DJANGO_DEBUG=1 for runserver or copy
# docker-compose.override.example.yml. Production Compose forces 0.
DJANGO_DEBUG=0
# Required when debug is off. Empty, change-me, and dev-only-not-for-production are refused.
DJANGO_SECRET_KEY=change-me
# Leave these unset on the VPS. Compose then keeps the production hosts
# (spotter.kadamsahil.com, srv1208763.hstgr.cloud, 127.0.0.1, localhost),
# https://spotter.kadamsahil.com, and DOMAIN=spotter.kadamsahil.com.
# A non-empty DJANGO_ALLOWED_HOSTS replaces that list. Keep 127.0.0.1,localhost
# or the container healthcheck returns HTTP 400.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=
# DOMAIN=
SQLITE_PATH=db.sqlite3
REDIS_URL=
OSRM_BASE_URL=https://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io
ORS_BASE_URL=https://api.heigit.org
ORS_API_KEY=
ROUTING_USER_AGENT=SpotterFuelRoute/1.0 (assessment)
CORRIDOR_MILES=10
TANK_RANGE_MILES=500
MPG=10
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
# Stdout log level. Unknown values fall back to INFO.
LOG_LEVEL=INFO
# deploy/deploy.sh sets this to the git short SHA. Compose defaults to latest.
# IMAGE_TAG=latest
